@startuml
title MiniPar 2026.2 — Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle

actor "Estudante / Usuário" as Usuario
actor "GCC (compilador C++)" as GCC

rectangle "Compilador MiniPar 2026.2" {
  usecase "Carregar programa\nMiniPar" as UC1
  usecase "Analisar tokens" as UC2
  usecase "Visualizar AST" as UC3
  usecase "Verificar semântica" as UC4
  usecase "Consultar tabela\nde símbolos" as UC5
  usecase "Gerar código TAC" as UC6
  usecase "Gerar código C++" as UC7
  usecase "Compilar programa" as UC8
  usecase "Executar programa" as UC9
  usecase "Consultar erros" as UC10
  usecase "Escolher interface\n(CLI ou Web)" as UC11
}

Usuario --> UC11
Usuario --> UC1
Usuario --> UC2
Usuario --> UC3
Usuario --> UC4
Usuario --> UC5
Usuario --> UC6
Usuario --> UC7
Usuario --> UC8
Usuario --> UC9
Usuario --> UC10

UC8 .> UC7 : <<include>>
UC9 .> UC8 : <<include>>
UC5 .> UC4 : <<extend>>
UC10 .> UC2 : <<extend>>
UC10 .> UC4 : <<extend>>
GCC --> UC8

note bottom of UC11
  A CLI e a interface Web são duas formas
  de acessar as funcionalidades do compilador.
end note
@enduml
