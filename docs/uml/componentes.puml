@startuml
title MiniPar 2026.2 — Diagrama de Componentes
top to bottom direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho

actor "Usuário" as user
cloud "GCC / G++\n(compilador externo)" as gcc

package "Interfaces de acesso" {
  [CLI] as cli
  [Frontend Web\n(HTML / CSS / JavaScript)] as frontend
  [Servidor Web\n(webapp.py / HTTP local)] as web
}

package "Compilador MiniPar (Python)" {
  [Pipeline\n(front_end / to_tac / to_cpp)] as pipeline
  component "Lexer" as lexer
  component "Parser" as parser
  component "AST\n(Program / Nodes)" as ast
  component "SemanticAnalyzer" as semantic
  component "SymbolTable\n(Scope / Symbol)" as symtable
  component "TACGenerator" as tac
  component "TACProgram\n(functions / classes / channels / globals)" as tacdata
  component "CppGenerator" as cppgen
  component "Driver\n(build_executable)" as driver
}

package "Ambiente de execução" {
  component "Runtime MiniPar\n(minipar_runtime.hpp)" as runtime
  component "Executável C++" as exe
}

user --> cli
user --> frontend
frontend --> web : HTTP local
cli --> pipeline : comandos
web --> lexer : tokens
web --> parser : AST
web --> semantic : análise
web --> symtable : consulta resultados
web --> tac : geração TAC
web --> pipeline : geração C++ (to_cpp)
pipeline --> lexer
pipeline --> parser
pipeline --> semantic
pipeline --> tac
lexer --> parser : tokens
parser --> ast : constrói
semantic --> ast : percorre
semantic --> symtable : constrói / consulta
tac --> ast : percorre
tac --> semantic : consulta análise
tac --> tacdata : produz
cppgen --> tacdata : recebe
pipeline --> cppgen : via to_cpp
web --> driver : compilar / executar
cli --> driver : build
driver --> gcc : compila C++17 / pthread
driver --> runtime : copia cabeçalho
gcc --> exe : produz
exe ..> runtime : inclui e utiliza

note right of pipeline
  front_end: léxico, sintático e semântico
  to_tac: valida e gera TAC
  to_cpp: gera C++ a partir do TAC
end note

note right of runtime
  Suporte de execução para tarefas
  paralelas e comunicação por canais.
end note
@enduml